# Copy this file to .env and fill in the values. Never commit .env.

# IMPORTANT: for an existing gym.db, use the original ENCRYPTION_KEY and DB_PEPPER.
# Changing either without a migration will prevent CCCD decryption/search from working.
# For a brand-new database ONLY, generate a Fernet key with:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# For a brand-new database ONLY, generate a random pepper with:
# python -c "import secrets; print(secrets.token_hex(32))"
DB_PEPPER=

# Email is optional. Leaving these blank disables outgoing email, not app startup.
SMTP_USER=
SMTP_PASSWORD=
